# Opzionale: senza chiave l'estrazione LLM è disabilitata e si usa il modulo manuale
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Opzionale: tutto questo è spento di default (SQLite, PDF in locale, nessun login) ---------------------
# Login: con AUTH_ENABLED=true al primo avvio nasce un amministratore (ADMIN_EMAIL, ADMIN_PASSWORD; se non imposti
# la password è «admin» e viene chiesto di cambiarla al primo accesso). Ogni account ha i suoi profili.
# AUTH_ENABLED=false
# ADMIN_EMAIL=admin@bollette.local
# ADMIN_PASSWORD=
# ALLOW_REGISTRATION=false  # true = chiunque può registrarsi dalla landing (nessuna verifica email: usalo con consapevolezza)
# TRUST_PROXY=false         # true dietro un reverse proxy (Caddy, nginx...): usa l'IP reale per i limiti di richieste e HTTPS per i cookie
# SECRET_KEY=            # firma dei token di accesso; senza, ne genera una e la conserva nel database (openssl rand -hex 32)
# ACCESS_MINUTES=15      # durata dell'access token (il refresh lo rinnova da solo); SESSION_DAYS=30 = durata massima senza usare l'app
# COOKIE_SECURE=auto     # auto = cookie «Secure» quando si arriva in HTTPS (anche dietro proxy con X-Forwarded-Proto)
# CRON_TOKEN=            # per l'aggiornamento offerte via HTTP con login attivo; più semplice: `docker exec ... flask --app app import-offers`
# Gestore del sito: compare nel piè di pagina, nei termini d'uso e nell'informativa privacy. Obbligatorio indicarlo se il sito è
# aperto ad altri (D.Lgs. 70/2003, art. 7; GDPR, art. 13). P. IVA solo se offri il servizio in forma di impresa.
# OPERATOR_NAME=
# OPERATOR_EMAIL=
# OPERATOR_ADDRESS=
# OPERATOR_VAT=
# OPERATOR_REGISTRY=   # iscrizione al Registro imprese / REA, se sei un'impresa
# Posta in uscita: attiva il «Password dimenticata?» del login. Senza MAIL_HOST e MAIL_FROM il recupero resta spento
# e chi perde la password chiede a un amministratore di reimpostarla.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURITY=starttls   # starttls | ssl | none
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=Bollette <bollette@example.com>
# APP_URL=https://bollette.example.com   # indirizzo pubblico, per i link nelle email (altrimenti quello della richiesta)
# Spazi pubblicitari (spenti di default): file JSON con i tuoi annunci; immagini e video (png/jpg/webp/gif, mp4/webm) nella stessa
# cartella. Esempio in deploy/ads.example.json. Sono annunci propri, serviti da questo server, senza tracciamento né cookie.
# ADS_FILE=/data/ads/ads.json
# Database vero invece di SQLite (PostgreSQL):
# DATABASE_URL=postgresql://utente:password@host:5432/bollette
# PDF su S3 / MinIO / R2 invece che nella cartella dati:
# STORAGE_DRIVER=s3
# S3_BUCKET=bollette
# S3_ENDPOINT_URL=http://minio:9000     # vuoto per AWS S3
# S3_REGION=eu-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=pdf
