# Opzionale: senza chiave l'estrazione LLM è disabilitata e si usa il modulo manuale
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Opzionale: tutto questo è spento di default (SQLite, PDF in locale, nessun login) ---------------------
# Login: con AUTH_ENABLED=true al primo avvio nasce un amministratore (ADMIN_EMAIL, ADMIN_PASSWORD; se non imposti
# la password è «admin» e viene chiesto di cambiarla al primo accesso). Ogni account ha i suoi profili.
# AUTH_ENABLED=false
# ADMIN_EMAIL=admin@bollette.local
# ADMIN_PASSWORD=
# CRON_TOKEN=            # per lo script di aggiornamento offerte quando il login è attivo (vedi deploy/README.md)
# Database vero invece di SQLite (PostgreSQL):
# DATABASE_URL=postgresql://utente:password@host:5432/bollette
# PDF su S3 / MinIO / R2 invece che nella cartella dati:
# STORAGE_DRIVER=s3
# S3_BUCKET=bollette
# S3_ENDPOINT_URL=http://minio:9000     # vuoto per AWS S3
# S3_REGION=eu-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=pdf
